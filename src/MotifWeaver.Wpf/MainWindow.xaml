<Window x:Class="MotifWeaver.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MotifWeaver" Height="450" Width="800"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1">
            <Canvas x:Name="EditorCanvas" Background="Transparent" MouseLeftButtonDown="MainCanvas_MouseLeftButtonDown" />
        </Border>

        <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1">
            <Canvas x:Name="ViewerCanvas" Background="Transparent" SizeChanged="ViewerCanvas_SizeChanged" />
        </Border>
    </Grid>
</Window>
