{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (console)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/MotifWeaver.Wpf/bin/Debug/net8.0-windows/MotifWeaver.Wpf.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": "Blazor WebAssembly",
            "type": "blazor",
            "request": "launch",
            "preLaunchTask": "blazor:run",
            "url": "http://localhost:5000",
            "browser": "chrome"
        },
        {
            "name": "Blazor WebAssembly (watch mode)",
            "type": "blazor",
            "request": "launch",
            "preLaunchTask": "blazor:watch",
            "url": "http://localhost:5000",
            "browser": "chrome",
            "cwd": "${workspaceFolder}/src/MotifWeaver.Blazor"
        }
    ]
}
